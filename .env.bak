# Module Articles / Publications
# Nombre maximal de pièces jointes par article (pdf/word/images...)
ARTICLE_MAX_ATTACHMENTS=5
# Taille max par pièce jointe (Mo)
ARTICLE_MAX_ATTACHMENT_MB=20
# Taille max de l'image de couverture (Mo)
ARTICLE_MAX_COVER_MB=8
# Types MIME autorisés pour les pièces jointes (séparés par virgule)
ARTICLE_ALLOWED_ATTACHMENT_MIMES=application/pdf,image/jpeg,image/png,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
# Types MIME autorisés pour l'image de couverture
ARTICLE_ALLOWED_COVER_MIMES=image/jpeg,image/png,image/webp

# -----------------------------------------------------------------------------
# Module Emails / Notifications adhérents
# -----------------------------------------------------------------------------
# Active / désactive l'envoi d'e-mails (best-effort).
#   false : aucun email n'est envoyé (défaut, sans impact sur API)
#   true  : envoi d'e-mails sur les événements suivants :
#             1. Demande d'adhésion reçue (accusé réception + lien /suivi?email=)
#             2. Validation comité d'accueil  (statut validee_accueil)
#             3. Validation comité directoire  (statut validee + identifiants si compte créé)
#             4. Rejet d'une demande           (statut rejetee + motif)
#             5. Confirmation paiement         (montant + reference)
MAIL_ENABLED=false

# Serveur SMTP (hébergement: Gmail, Brevo/Sendinblue, Mailgun, SMTP OVH/infomaniak, etc.)
#   Exemples de ports courants :
#     465 (SSL implicite, passe MAIL_USE_SSL=true, MAIL_USE_TLS=false)
#     587 (STARTTLS, défaut, passe MAIL_USE_TLS=true, MAIL_USE_SSL=false)
#     25  (SMTP non chiffré, à éviter en prod, localhost ou relay interne)
SMTP_HOST=
SMTP_PORT=587
# Credentials SMTP (laisser vides si serveur SMTP local sans auth)
SMTP_USERNAME=
SMTP_PASSWORD=
# Sécurité TLS/SSL : cocher UNE DES DEUX options (SSL sur 465, OU TLS/STARTTLS sur 587)
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Expéditeur (From:) — la plupart des FAI requièrent que mail_from = SMTP_USERNAME
MAIL_FROM=
MAIL_FROM_NAME=MONCAP

# -----------------------------------------------------------------------------
