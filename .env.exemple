# ============================================================
# CORS - CRITIQUE POUR LES ENDPOINTS PROTÉGÉS (/mon-compte/*, JWT Bearer)
#
# ⚠️ RÈGLE OBLIGATOIRE W3C CORS :
#    Ne JAMAIS mettre '*' (astérisque) si CORS_ALLOW_CREDENTIALS=true !
#    → Le navigateur BLOQUE SYSTÉMATIQUEMENT les requêtes avec `Authorization: Bearer xxx`
#      si `Access-Control-Allow-Origin` est '*' → erreur CORS sur les endpoints protégés.
#    → Toujours mettre la liste EXACTE des domaines frontend autorisés,
#      PROTOCOLE inclus (https://, http://, PORT inclus si non standard :8080 etc.)
#
# Format : tableau JSON (ou CSV séparé par virgule)
# localhost 5173/3000/8080 sont ajoutés AUTOMATIQUEMENT par app.main.py (dev local),
# mais il vaut mieux les lister explicitement ici pour être sûr.
# ============================================================
CORS_ALLOW_ORIGINS=[
  "https://moncap.innovamind.tech",
  "http://moncap.innovamind.tech",
  "https://www.moncap.innovamind.tech",
  "http://www.moncap.innovamind.tech",
  "http://localhost:5173",
  "http://localhost:3000",
  "http://localhost:8080",
  "http://127.0.0.1:5173",
  "http://127.0.0.1:3000"
]
CORS_ALLOW_CREDENTIALS=true

REFRESH_COOKIE_NAME=moncap_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth

STORAGE_DIR=storage
PUBLIC_FILES_PATH=/files
# Utilisé pour préfixer toutes les URLs relatives de fichiers (/files/...)
# en URL absolue dans les réponses API (cover_url, attachments, photos, CVs, etc.).
# Indispensable si votre frontend et votre backend sont sur des ports différents
# en développement, ou en production (même domaine via proxy non garanti).
# Dev local exemple :  http://localhost:8000
# Prod frontend    exemple :  https://moncap.innovamind.tech
API_BASE_URL=http://localhost:8000

# URL BASE DU BACKEND (PUBLIQUE UTILISEE NOTAMMENT DANS LE CONTENU DES QR CODES PERMANENTS.
# IMPORTANT : JAMAIS l'URL FRONTEND ICI (doit pointer vers BACKEND (Alwaysdata ou autre hebergeur backend).
# Dev local exemple : http://localhost:8000
# Prod Alwaysdata MONCAP : https://thior.alwaysdata.net
# Si vide, on retombe sur api_base_url puis sur fallback.
BACKEND_PUBLIC_BASE_URL=https://thior.alwaysdata.net

# Module Articles / Publications
# Nombre maximal de pièces jointes par article (pdf/word/images...)
ARTICLE_MAX_ATTACHMENTS=5
# Taille max par pièce jointe (Mo)
ARTICLE_MAX_ATTACHMENT_MB=20
# Taille max de l'image de couverture (Mo)
ARTICLE_MAX_COVER_MB=8
# Types MIME autorisés pour les pièces jointes (séparés par virgule)
ARTICLE_ALLOWED_ATTACHMENT_MIMES=application/pdf,image/jpeg,image/png,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
# Types MIME autorisés pour l'image de couverture
ARTICLE_ALLOWED_COVER_MIMES=image/jpeg,image/png,image/webp

# -----------------------------------------------------------------------------
# Module Emails / Notifications adhérents (IMPORTANT)
# -----------------------------------------------------------------------------
# Mise en garde :
#   Par défaut MAIL_ENABLED=false → AUCUN email n'est envoyé, quel que soit
#   l'événement (création, validation comité accueil, validation directoire,
#   rejet, confirmation de paiement).
#
#   Pour que les adhérents recoivent bien les notifications, il faut :
#     1. Mettre MAIL_ENABLED=true
#     2. Renseigner SMTP_HOST/SMTP_PORT (et credentials si nécessaire)
#     3. Renseigner MAIL_FROM (expéditeur)
#
#   Tous les envois sont :
#     - Non-bloquants (BackgroundTasks FastAPI → pas d'impact sur le temps
#       de réponse des endpoints d'admin ou d'adhésion publique)
#     - Best-effort : si SMTP est en panne, la transaction est quand même
#       validée en base de données (aucun rollback sur une erreur mail)
# -----------------------------------------------------------------------------
MAIL_ENABLED=false

# Serveur SMTP (hébergement: Gmail, Brevo/Sendinblue, Mailgun, SMTP OVH/infomaniak, etc.)
#   Ports courants :
#     465 (SSL implicite  → passer MAIL_USE_SSL=true,  MAIL_USE_TLS=false)
#     587 (STARTTLS       → passer MAIL_USE_TLS=true,  MAIL_USE_SSL=false)   (défaut)
#     25  (SMTP local     → les deux à false, pour des tests/relais interne)
SMTP_HOST=
SMTP_PORT=587
# Credentials SMTP (laisser vides si votre serveur SMTP n'exige pas d'authentification,
#  typiquement un relay sur le réseau local)
SMTP_USERNAME=
SMTP_PASSWORD=
# Sécurité TLS/SSL : ne jamais activer les deux en même temps
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Adresse expéditeur (FROM). Sur les hébergeurs SMTP (Gmail, Brevo...),
# MAIL_FROM doit généralement être identique à SMTP_USERNAME (ou un alias validé).
MAIL_FROM=
MAIL_FROM_NAME=MONCAP

# -----------------------------------------------------------------------------
# Module PAEMENTS / KOPAR PAY (Obligatoire pour activer les paiements)
# -----------------------------------------------------------------------------
#   Activation globale :
#     - KOPAR_ENABLED=true  → les paiements Wave / Orange Money / carte bancaire
#                            via Kopar Pay sont disponibles
#     - KOPAR_ENABLED=false → aucun paiement Kopar n'est initié (mode test)
#
#   Clés fournies par Kopar Express (contact: seydou.ba@koparexpress.com)
#     - KOPAR_API_KEY     : clé publique/marchande (dans POST body /api/v2/transaction/request)
#     - KOPAR_PRIVATE_KEY : clé privée (SEULEMENT pour vérifier la signature HMAC
#                           SHA256 du header X-KOPAR-SIGNATURE du webhook)
#   Attention : ne JAMAIS exposer KOPAR_PRIVATE_KEY côté client.
#
#   URL de base Kopar (valeur par défaut : https://koparpay.com)
#     - En démo / sandbox : changer selon les consignes Kopar.
#
# -----------------------------------------------------------------------------
# Module PAEMENTS / KOPAR PAY — RECONCILIATION (fallback anti-régression)
# -----------------------------------------------------------------------------
#   Quand Kopar Pay ne parvient pas à appeler notre webhook (ex: Alwaysdata down,
#   URL webhook erronée, signature invalide...) la transaction reste éternellement
#   en statut "new" même si l'utilisateur a VRAIMENT payé sur Wave/OM. Résultat :
#   front affiche la bannière "Frais d'adhésion non réglés".
#
#   → Solution : un job CLI qui POLLE Kopar régulièrement pour vérifier le statut
#   des transactions en attente et rattraper ce que le webhook a manqué.
#
#   RECONCILE_KOPAR_ENABLED = true/false
#     true  → job activé (par défaut). Script tourne en mode one-shot / daemon.
#     false → script s'arrête immédiatement avec exit code 0 (sauf --force).
#
#   RECONCILE_KOPAR_OLDER_MINUTES = entier (défaut 5)
#     Ne traiter QUE les transactions créées il y a au moins N minutes.
#     Donne une chance au webhook Kopar de jouer d'abord en synchrone.
#
#   RECONCILE_KOPAR_POLL_SECONDS = entier (défaut 300 = 5 minutes)
#     Période entre DEUX boucles du job quand on le lance avec --daemon.
#
#   Exemples de lancement Alwaysdata :
#     # Mode one-shot (à mettre dans CRON toutes les 5 minutes)
#     */5 * * * * cd /home/thior/www && python -m app.cli.reconcile_kopar_pending_transactions --apply --once
#
#     # Mode daemon (processus long en alwaysdata service)
#     python -m app.cli.reconcile_kopar_pending_transactions --apply --daemon
# -----------------------------------------------------------------------------
RECONCILE_KOPAR_ENABLED=true
RECONCILE_KOPAR_OLDER_MINUTES=5
RECONCILE_KOPAR_POLL_SECONDS=300

# Montants par défaut (fallback si la table parametres_paiement est vide) :
#     Ces valeurs sont utilisées UNIQUEMENT au 1er démarrage, avant que les
#     lignes "adhesion_initiale" et "cotisation_mensuelle" ne soient créées
#     en base. Après cela, CE SONT LES VALEURS EN BASE QUI FONT FOI.
#     Pour modifier les montants : utiliser l'endpoint admin
#     POST /api/v1/admin/parametres-paiement avec la nouvelle date d'effet.
# -----------------------------------------------------------------------------
KOPAR_ENABLED=false
KOPAR_BASE_URL=https://koparpay.com
KOPAR_API_KEY=
KOPAR_PRIVATE_KEY=

DEFAULT_ADHESION_FCFA=5
DEFAULT_COTISATION_MENSUELLE_FCFA=5

