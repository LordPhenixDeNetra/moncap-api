#    SMTP_HOST=127.0.0.1
#    SMTP_PORT=1025
#    SMTP_USE_TLS=false
#    SMTP_USE_SSL=false
#    MAIL_FROM=no-reply@moncap.local
# -----------------------------------------------------------------------------

